# Copie para .env.local e preencha com os dados do seu projeto Nhost
# (Painel do Nhost > Settings > Project Info / Hasura).
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=
# Segredo de administrador do Hasura. Só é usado no servidor; nunca exponha no navegador.
NHOST_ADMIN_SECRET=
# Opcional: segredo compartilhado com o n8n para o webhook /api/webhooks/n8n
N8N_WEBHOOK_SECRET=
