# Copie para .env.local e preencha com os dados do seu projeto Nhost
# (Painel do Nhost > Settings > Project Info / Hasura).
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=
# Segredo de administrador do Hasura. Só é usado no servidor; nunca exponha no navegador.
NHOST_ADMIN_SECRET=
# Opcional: segredo compartilhado com o n8n para o webhook /api/webhooks/n8n
N8N_WEBHOOK_SECRET=

# Conta de demonstração (botão "Entrar como cliente de demonstração" no login).
# Crie a conta com: npm run user:create -- --email demo@astacar.dev --name "Cliente Demonstração"
DEMO_CLIENT_EMAIL=
DEMO_CLIENT_PASSWORD=
# Opcional: "on" deixa a conta de demonstração pagar online (use só com credenciais de TESTE do Mercado Pago)
DEMO_ONLINE_PAYMENT=

# Mercado Pago (pagamento online com Payment Brick). Painel: https://www.mercadopago.com.br/developers/panel/app
# Use as credenciais da aba "Teste" para testar e as da aba "Produção" para cobrar de verdade.
# Access Token: só no servidor, nunca exponha.
MP_ACCESS_TOKEN=
# Public Key: vai para o navegador (por isso o prefixo NEXT_PUBLIC_). Sem ela o checkout só oferece pagamento na retirada.
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Assinatura secreta dos webhooks (Suas integrações > Webhooks), para validar x-signature em /api/webhooks/mercadopago
MP_WEBHOOK_SECRET=

# E-mails da reserva (confirmação e lembrete na véspera) pelo Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Remetente num domínio verificado no Resend, ex.: AstaCar <reservas@seudominio.com.br>
EMAIL_FROM=
# Opcional: endereço que recebe as respostas dos clientes
EMAIL_REPLY_TO=
# Segredo do Vercel Cron (/api/cron/lembretes, todo dia às 18h de Brasília). Mínimo de 16 caracteres.
CRON_SECRET=
